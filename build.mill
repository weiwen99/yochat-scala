//| mill-jvm-version: system
//| mvnDeps:
//| - "com.goyeau::mill-scalafix::0.6.2"
//| - "ch.epfl.scala:scalafix-interfaces:0.14.9"

package build

import com.goyeau.mill.scalafix.ScalafixModule
import mill.*
import scalalib.*
import scalalib.scalafmt.*

trait CommonModule extends ScalaModule:

  def scalaVersion = "3.10.1"

  def scalacOptions = Seq(
    "-deprecation",
    "-encoding", "UTF-8",
    "-feature",
    "-unchecked",
    "-Wunused:all",
    "-Werror",
    "-source", "future",
    "-Xmax-inlines", "64"
  )

object core extends CommonModule with ScalafmtModule with ScalafixModule:

  def mvnDeps = Seq(
    mvn"org.scodec::scodec-bits:1.2.1"
  )

  object test extends ScalaTests with TestModule.Munit:

    def mvnDeps = Seq(
      mvn"org.scalameta::munit:1.1.1"
    )

object spike extends CommonModule with ScalafmtModule with ScalafixModule:

  def mainClass = Some("yochat.spike.SpikeMain")

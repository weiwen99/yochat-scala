//| mill-jvm-version: system
//| mvnDeps:
//| - "com.goyeau::mill-scalafix::0.6.2"
//| - "ch.epfl.scala:scalafix-interfaces:0.14.9"

package build

import com.goyeau.mill.scalafix.ScalafixModule
import mill.*
import scalalib.*
import scalalib.scalafmt.*

trait CommonModule extends ScalaModule:

  def scalaVersion = "3.10.1"

  def scalacOptions = Seq(
    "-deprecation",
    "-encoding", "UTF-8",
    "-feature",
    "-unchecked",
    "-Wunused:all",
    "-Werror",
    "-source", "future",
    "-Xmax-inlines", "64"
  )

object core extends CommonModule with ScalafmtModule with ScalafixModule:

  def mvnDeps = Seq(
    mvn"org.scodec::scodec-bits:1.2.1"
  )

  object test extends ScalaTests with TestModule.Munit:

    def mvnDeps = Seq(
      mvn"org.scalameta::munit:1.1.1",
      mvn"com.lihaoyi::ujson:4.4.3"
    )

object store extends CommonModule with ScalafmtModule with ScalafixModule:

  def moduleDeps = Seq(core)

  def mvnDeps = Seq(
    mvn"org.xerial:sqlite-jdbc:3.54.1.0",
    mvn"org.typelevel::cats-effect:3.7.1",
    mvn"org.typelevel::doobie-core:1.0.0-RC14",
    mvn"org.typelevel::doobie-hikari:1.0.0-RC14",
    mvn"org.bouncycastle:bcprov-jdk18on:1.87",
    mvn"ch.qos.logback:logback-classic:1.6.8"
  )

  object test extends ScalaTests with TestModule.Munit:

    def mvnDeps = Seq(
      mvn"org.scalameta::munit:1.3.6"
    )

object spike extends CommonModule with ScalafmtModule with ScalafixModule:

  def mvnDeps = Seq(
    mvn"org.xerial:sqlite-jdbc:3.54.1.0",
    mvn"org.typelevel::cats-effect:3.7.1",
    mvn"org.typelevel::doobie-core:1.0.0-RC14",
    mvn"org.typelevel::doobie-hikari:1.0.0-RC14"
  )

  def mainClass = Some("yochat.spike.SpikeMain")

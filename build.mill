//| mill-jvm-version: system
//| mvnDeps:
//| - "com.goyeau::mill-scalafix::0.6.2"
//| - "ch.epfl.scala:scalafix-interfaces:0.14.9"

package build

import com.goyeau.mill.scalafix.ScalafixModule
import mill.*
import mill.scalajslib.*
import scalalib.*
import scalalib.scalafmt.*

trait CommonModule extends ScalaModule:

  def scalaVersion = "3.10.1"

  def scalacOptions = Seq(
    "-deprecation",
    "-encoding", "UTF-8",
    "-feature",
    "-unchecked",
    "-Wunused:all",
    "-Werror",
    "-source", "future",
    "-Xmax-inlines", "64"
  )

object core extends CommonModule with ScalafmtModule with ScalafixModule:

  def mvnDeps = Seq(
    mvn"org.scodec::scodec-bits:1.2.1"
  )

  object test extends ScalaTests with TestModule.Munit:

    def mvnDeps = Seq(
      mvn"org.scalameta::munit:1.1.1",
      mvn"com.lihaoyi::ujson:4.4.3"
    )

object store extends CommonModule with ScalafmtModule with ScalafixModule:

  def moduleDeps = Seq(core)

  def mvnDeps = Seq(
    mvn"org.xerial:sqlite-jdbc:3.54.1.0",
    mvn"org.typelevel::cats-effect:3.7.1",
    mvn"org.typelevel::doobie-core:1.0.0-RC14",
    mvn"org.typelevel::doobie-hikari:1.0.0-RC14",
    mvn"org.bouncycastle:bcprov-jdk18on:1.87",
    mvn"ch.qos.logback:logback-classic:1.6.8"
  )

  object test extends ScalaTests with TestModule.Munit:

    def mvnDeps = Seq(
      mvn"org.scalameta::munit:1.3.6"
    )

object transport extends CommonModule with ScalafmtModule with ScalafixModule:

  def moduleDeps = Seq(core)

  def mvnDeps = Seq(
    mvn"org.typelevel::cats-effect:3.7.1"
  )

  def mainClass = Some("yochat.transport.RelayMain")

  object test extends ScalaTests with TestModule.Munit:

    def mvnDeps = Seq(
      mvn"org.scalameta::munit:1.3.6"
    )

trait CommonJsModule extends ScalaJSModule with ScalafmtModule with ScalafixModule:

  def scalaVersion = "3.10.1"
  def scalaJSVersion = "1.23.0"

  def scalacOptions = Seq(
    "-deprecation",
    "-encoding", "UTF-8",
    "-feature",
    "-unchecked",
    "-Wunused:all",
    "-Werror",
    "-source", "future",
    "-Xmax-inlines", "64"
  )

object ui extends CommonJsModule:

  def mvnDeps = Seq(
    mvn"com.raquo::laminar::17.2.1",
    mvn"org.scala-js::scalajs-dom::2.8.0",
    mvn"com.lihaoyi::ujson::4.4.3"
  )

object server extends CommonModule with ScalafmtModule with ScalafixModule:

  def moduleDeps = Seq(core, store, transport)

  def mvnDeps = Seq(
    mvn"org.typelevel::cats-effect:3.7.1",
    mvn"com.lihaoyi::ujson:4.4.3",
    mvn"org.apache.pekko::pekko-http:1.3.0",
    mvn"org.apache.pekko::pekko-stream:1.6.0"
  )

  def mainClass = Some("yochat.server.Main")

  /** 10k store restore benchmark, with a warmup store and p50/p95 samples. */
  def bench(): Command[Unit] = Task.Command {
    val classpath = test.runClasspath().map(_.path).mkString(java.io.File.pathSeparator)
    os.proc("java", "-cp", classpath, "yochat.server.RestoreBench").call(
      cwd = moduleDir,
      stdout = os.Inherit,
      stderr = os.Inherit
    )
    ()
  }

  /** Two-process functional S1 behavior contracts. Not a load test. */
  def e2e(): Command[Unit] = Task.Command {
    val classpath = test.runClasspath().map(_.path).mkString(java.io.File.pathSeparator)
    Option(System.getProperty("e2e.only")) match
      case Some(contract) =>
        os.proc("java", s"-De2e.only=$contract", "-cp", classpath, "yochat.server.e2e.S1E2E").call(
          cwd = moduleDir,
          stdout = os.Inherit,
          stderr = os.Inherit
        )
      case None           =>
        os.proc("java", "-cp", classpath, "yochat.server.e2e.S1E2E").call(
          cwd = moduleDir,
          stdout = os.Inherit,
          stderr = os.Inherit
        )
    ()
  }

  /** Fixed S2-A companion behavior contract; requires a built server and test classpath. */
  def s2e2e(): Command[Unit] = Task.Command {
    val classpath = test.runClasspath().map(_.path).mkString(java.io.File.pathSeparator)
    os.proc("java", "-cp", classpath, "yochat.server.e2e.S2E2E").call(
      cwd = moduleDir,
      stdout = os.Inherit,
      stderr = os.Inherit
    )
    ()
  }

  /** B2#2: 1k direct B1→A2 messages while A1 is offline, within 5s. */
  def s2bperf(): Command[Unit] = Task.Command {
    val classpath = test.runClasspath().map(_.path).mkString(java.io.File.pathSeparator)
    os.proc("java", "-cp", classpath, "yochat.server.e2e.S2E2E", "--fanout-perf").call(
      cwd = moduleDir,
      stdout = os.Inherit,
      stderr = os.Inherit
    )
    ()
  }

  /** S2#2: 1k post-join messages sync from A1 to A2 within 5s. */
  def s2perf(): Command[Unit] = Task.Command {
    val classpath = test.runClasspath().map(_.path).mkString(java.io.File.pathSeparator)
    os.proc("java", "-cp", classpath, "yochat.server.e2e.S2E2E", "--perf").call(
      cwd = moduleDir,
      stdout = os.Inherit,
      stderr = os.Inherit
    )
    ()
  }

  def resources = Task {
    val resourceRoot = Task.dest
    val publicDir    = resourceRoot / "public"
    os.makeDir.all(publicDir)
    os.copy(ui.fastLinkJS().dest.path / "main.js", publicDir / "yochat.js", replaceExisting = true)
    super.resources().foreach { ref =>
      val source = ref.path / "public"
      if os.isDir(source) then os.copy(source, publicDir, replaceExisting = true, mergeFolders = true)
    }
    Seq(PathRef(resourceRoot))
  }

  object test extends ScalaTests with TestModule.Munit:

    def mvnDeps = Seq(
      mvn"org.scalameta::munit:1.3.6"
    )

object spike extends CommonModule with ScalafmtModule with ScalafixModule:

  def mvnDeps = Seq(
    mvn"org.xerial:sqlite-jdbc:3.54.1.0",
    mvn"org.typelevel::cats-effect:3.7.1",
    mvn"org.typelevel::doobie-core:1.0.0-RC14",
    mvn"org.typelevel::doobie-hikari:1.0.0-RC14"
  )

  def mainClass = Some("yochat.spike.SpikeMain")

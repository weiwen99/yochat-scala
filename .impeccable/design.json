      "name": "Delivery Score",
      "kind": "custom",
      "description": "A message gutter whose square fill encodes delivery certainty.",
      "html": "<div class=\"message own delivered\"><div class=\"score\"><span class=\"score-mark\"></span></div><div class=\"message-content\"><div class=\"bubble\">Message</div><div class=\"message-state\">已送达</div></div></div>",
      "css": ".message{display:grid;grid-template-columns:24px minmax(0,1fr);gap:14px}.message.own{grid-template-columns:minmax(0,1fr) 24px}.score{position:relative;display:flex;justify-content:center;padding-top:7px}.score:before{content:'';position:absolute;inset:0 auto -17px 50%;width:1px;background:var(--line)}.score-mark{position:relative;z-index:1;width:9px;height:9px;border:1px solid var(--ink);background:var(--paper)}.delivered .score-mark{background:var(--ink)}.sent .score-mark{background:linear-gradient(90deg,var(--ink) 0 50%,var(--paper) 50%)}.pending .score-mark{border-style:dotted}"
    },
    {

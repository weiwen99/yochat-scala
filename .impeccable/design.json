      "css": ".ledger{border-left:1px solid var(--line);background:var(--sheet);overflow-y:auto}.ledger-section h3{margin:0 0 10px;color:var(--muted);font-family:var(--mono);font-size:9px;letter-spacing:.14em;text-transform:uppercase}.route-card{padding:12px;border:1px solid var(--line);background:var(--paper)}"
